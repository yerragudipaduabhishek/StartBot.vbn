# ---- Environment ----
# global (api.delta.exchange) | india (api.india.delta.exchange)
DELTA_REGION=global

# ---- Delta Exchange credentials (required for testnet execution validation) ----
# Use TESTNET keys (create at testnet.delta.exchange -> settings -> API keys).
DELTA_API_KEY=
DELTA_API_SECRET=

# ---- Market ----
# global: BTCUSDT | india: BTCUSD
TRADING_SYMBOL=BTCUSDT
# Strategy A is locked to 1h; changing this is rejected at startup.
TRADING_TIMEFRAME=1h
HISTORY_LIMIT=500

# ---- Execution safety (read the comments - these are load-bearing) ----
# LIVE_MODE must stay false. This release refuses to start when it is true;
# DeltaLiveBroker refuses construction. There is no reachable live order path.
LIVE_MODE=false

# TESTNET_MODE on resolves every ORDER endpoint to the Delta testnet host and
# refuses to run against production endpoints (see app/execution/safety.py).
# Keep on for the validation phase.
TESTNET_MODE=on

# Extra gate for production orders only. Keep false.
REAL_ORDER_CONFIRMATION=false

# ---- Testnet execution-validation layer ----
# Poll budget when waiting for an order to fill (seconds x polls).
DELTA_EXECUTION_POLL_SECS=2
DELTA_EXECUTION_MAX_POLLS=30
# Local audit + recovery state (JSONL + CSV + JSON). Relative to repo root.
DELTA_EXECUTION_STATE_FILE=logs/testnet_state.json
DELTA_EXECUTION_JOURNAL=logs/testnet_executions.jsonl
# Prefix for client_order_id so duplicates are detectable across restarts.
DELTA_CLIENT_ID_PREFIX=btcai-tn
# When false (default), SL/TP are monitored SIMULATED locally and exits close
# with reduce-only testnet market orders - no dependency on native stop orders.
DELTA_EXECUTION_NATIVE_SLTP=false

# ---- Public data override (optional) ----
# Only affects candle/history reads, never order placement. Uncomment if you
# need production history while the account/order path stays on testnet:
# DELTA_DATA_URL_OVERRIDE=https://api.delta.exchange

# ---- Paper account (Phase 6: deterministic local simulation) ----
# The paper engine runs on its OWN simulated ₹ fund, entirely separate from
# the "Trading Fund" used for decision sizing. It never places an order on
# Delta - entries/exits are simulated locally against real market candles.
PAPER_FUND_INR=5000
PAPER_RISK_PCT=0.5
PAPER_FEE_PCT=0.05
PAPER_SLIPPAGE_PCT=0.02
PAPER_CONTRACT_VALUE=0.001
PAPER_SYMBOL=BTCUSDT

# ---- Database ----
# SQLite by default (zero install). Swap to Postgres later, e.g.:
#   postgresql+psycopg2://user:pass@localhost:5432/trading
DATABASE_URL=sqlite:///./data/trading.db
# Research datasets/experiments are isolated from trading state. Never point
# this at the trading database (startup rejects identical URLs).
RESEARCH_DATABASE_URL=sqlite:///./data/research.db

# ---- AI / Sentiment (optional; system works offline without these) ----
# none | openai | anthropic
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional free news feed key for sentiment agent (e.g. NewsAPI / CryptoPanic)
NEWS_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Backend bind + admin control (uvicorn) ----
# Loopback by default. A VPS/reverse-proxy deployment must opt in explicitly.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Required to authorize watchlist mutations and kill-switch halt/resume over
# HTTP. Leave empty to disable those control endpoints (fail closed). Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ---- Dashboard (dashboard/.env.local or dashboard/.env.example) ----
# BACKEND_URL is the base URL the Next.js dashboard proxies /api/* to. Point
# it at the backend the browser can reach (localhost for local dev, the VPS
# hostname/IP when deployed), e.g.:
#   BACKEND_URL=https://api.example.com   (or http://1.2.3.4:8000)
# Default when unset: http://127.0.0.1:8000
# ---- Deployment profile + API hardening ----
# dev | test | paper | staging | live
# paper/staging/live require ADMIN_TOKEN (24+ chars), an explicit CORS
# allowlist, loopback bind (or ALLOW_PUBLIC_BIND=true behind TLS), and
# TESTNET_MODE=on. Anything unsafe refuses to start.
ENVIRONMENT=dev
ALLOW_PUBLIC_BIND=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In-process per-client request budget; /health and /metrics are exempt.
RATE_LIMIT_PER_MINUTE=600
# Maximum accepted request body in bytes (HTTP 413 above this).
MAX_REQUEST_BYTES=1000000
# Only enable when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ---- Logging rotation ----
# Optional JSON log file; rotates at LOG_MAX_BYTES with LOG_BACKUP_COUNT files.
LOG_FILE=
LOG_MAX_BYTES=10000000
LOG_BACKUP_COUNT=5
